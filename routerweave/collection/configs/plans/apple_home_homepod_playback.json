{
  "experiment": "apple_home_homepod_mini_playback_30x",
  "control_platform": "apple_home",
  "target_valid_per_action": 30,
  "launch_wait_seconds": 3,
  "max_consecutive_failures": 2,
  "dashboard_condition": {
    "selector": {
      "type": "XCUIElementTypeButton",
      "name": "Home.Tab.家庭",
      "label": "家庭"
    }
  },
  "router": {
    "host": "${ROUTERWEAVE_ROUTER_HOST}",
    "user": "root",
    "interface": "br-lan",
    "identity_file": "${ROUTERWEAVE_SSH_KEY}",
    "capture_filter": "host ${ROUTERWEAVE_APPLE_HOMEPOD_MINI_IP}"
  },
  "controller": {
    "identifier": "${IOS_UDID}",
    "application": "Apple Home",
    "application_bundle_id": "com.apple.Home",
    "wda_url": "http://127.0.0.1:8100"
  },
  "devices": [
    {
      "id": "apple-homepod-mini",
      "name": "HomePod",
      "brand": "Apple",
      "model": "HomePod mini",
      "device_type": "smart_speaker",
      "manage_playback_volume": false,
      "ip": "${ROUTERWEAVE_APPLE_HOMEPOD_MINI_IP}",
      "mac": "${ROUTERWEAVE_APPLE_HOMEPOD_MINI_MAC}",
      "actions": [
        "play",
        "pause"
      ],
      "open_gesture": "long_press",
      "open_press_seconds": 0.9,
      "open_wait_seconds": 4,
      "baseline_seconds": 5,
      "tail_seconds": 30,
      "poll_seconds": 10,
      "state_timeout_seconds": 30,
      "inter_action_cooldown_seconds": 0,
      "ui": {
        "page_condition": {
          "all": [
            {
              "selector": {
                "type": "XCUIElementTypeStaticText",
                "name": "AccessoryControl.SheetView",
                "label": "HomePod",
                "value": "HomePod"
              }
            },
            {
              "selector": {
                "type": "XCUIElementTypeOther",
                "name": "AccessoryControl.mediaPlayback.MediaRemote",
                "label": "媒体控制"
              }
            }
          ]
        },
        "playing_condition": {
          "any": [
            {
              "selector": {
                "type": "XCUIElementTypeButton",
                "name": "暂停",
                "label": "暂停"
              }
            },
            {
              "selector": {
                "type": "XCUIElementTypeButton",
                "name": "停止",
                "label": "停止"
              }
            }
          ]
        },
        "paused_condition": {
          "selector": {
            "type": "XCUIElementTypeButton",
            "name": "播放",
            "label": "播放"
          }
        },
        "play_selector": {
          "type": "XCUIElementTypeButton",
          "name": "播放",
          "label": "播放"
        },
        "pause_selector": {
          "any": [
            {
              "selector": {
                "type": "XCUIElementTypeButton",
                "name": "暂停",
                "label": "暂停"
              }
            },
            {
              "selector": {
                "type": "XCUIElementTypeButton",
                "name": "停止",
                "label": "停止"
              }
            }
          ]
        },
        "close_selector": {
          "type": "XCUIElementTypeButton",
          "name": "AccessoryControl.SheetView",
          "label": "关闭"
        }
      }
    }
  ]
}
