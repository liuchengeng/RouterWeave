{
  "experiment": "apple_home_iot_continuous_30x",
  "control_platform": "apple_home",
  "target_valid_per_action": 30,
  "router": {
    "host": "${ROUTERWEAVE_ROUTER_HOST}",
    "user": "root",
    "interface": "br-lan",
    "identity_file": "${ROUTERWEAVE_SSH_KEY}"
  },
  "controller": {
    "application": "Apple Home",
    "application_bundle_id": "com.apple.Home",
    "wda_url": "http://127.0.0.1:8100"
  },
  "dashboard_name": "我的家",
  "detail_close_name": "关闭",
  "launch_wait_seconds": 2,
  "detail_close_wait_seconds": 2,
  "devices": [
    {
      "id": "meross-mss110",
      "name": "meross smart plug",
      "device_type": "smart_plug",
      "ip": "${ROUTERWEAVE_MEROSS_MSS110_IP}",
      "mac": "${ROUTERWEAVE_MEROSS_MSS110_MAC}",
      "states": {
        "off": [
          "关",
          "关闭"
        ],
        "on": [
          "开",
          "打开"
        ]
      },
      "actions": [
        {
          "name": "power_on",
          "from": "off",
          "to": "on"
        },
        {
          "name": "power_off",
          "from": "on",
          "to": "off"
        }
      ],
      "baseline_seconds": 5,
      "state_timeout_seconds": 30,
      "poll_seconds": 2,
      "tail_seconds": 30
    },
    {
      "id": "eve-smart-plug",
      "name": "Eve smart plug",
      "device_type": "smart_plug",
      "observed_via": "thread_home_hub",
      "states": {
        "off": [
          "关",
          "关闭"
        ],
        "on": [
          "开",
          "打开"
        ]
      },
      "actions": [
        {
          "name": "power_on",
          "from": "off",
          "to": "on"
        },
        {
          "name": "power_off",
          "from": "on",
          "to": "off"
        }
      ],
      "baseline_seconds": 5,
      "state_timeout_seconds": 30,
      "poll_seconds": 2,
      "tail_seconds": 30
    },
    {
      "id": "ultraloq-bolt",
      "name": "Ultraloq Bolt Smart Deadbolt Lock",
      "device_type": "smart_lock",
      "ip": "${ROUTERWEAVE_ULTRALOQ_BOLT_IP}",
      "mac": "${ROUTERWEAVE_ULTRALOQ_BOLT_MAC}",
      "states": {
        "locked": [
          "已锁",
          "锁定"
        ],
        "unlocked": [
          "未锁",
          "已解锁"
        ]
      },
      "actions": [
        {
          "name": "unlock",
          "from": "locked",
          "to": "unlocked"
        },
        {
          "name": "lock",
          "from": "unlocked",
          "to": "locked"
        }
      ],
      "baseline_seconds": 5,
      "state_timeout_seconds": 120,
      "poll_seconds": 5,
      "tail_seconds": 30
    }
  ]
}
