{
  "experiment": "map100_apple_fan_1_2_formal",
  "control_platform": "apple_home",
  "target_valid_per_action": 15,
  "router": {
    "host": "${ROUTERWEAVE_ROUTER_HOST}",
    "user": "root",
    "interface": "br-lan",
    "identity_file": "${ROUTERWEAVE_SSH_KEY}",
    "capture_filter": "ether host ${ROUTERWEAVE_MEROSS_MAP100_MAC}"
  },
  "controller": {
    "identifier": "${IOS_UDID}",
    "application": "Apple Home",
    "application_bundle_id": "com.apple.Home",
    "wda_url": "http://127.0.0.1:8100",
    "snapshot_max_depth": 50
  },
  "devices": [
    {
      "id": "meross-map100",
      "name": "meross Smart Wi-Fi Air Purifier",
      "brand": "Meross",
      "model": "MAP100",
      "device_type": "air_purifier",
      "observed_via": "direct_device",
      "ip": "${ROUTERWEAVE_MEROSS_MAP100_IP}",
      "mac": "${ROUTERWEAVE_MEROSS_MAP100_MAC}",
      "states": {
        "off": [
          "关"
        ],
        "g1": [
          "25%"
        ],
        "g2": [
          "50%"
        ],
        "g3": [
          "75%"
        ],
        "g4": [
          "100%"
        ]
      },
      "actions": [
        {
          "name": "fan_speed_up",
          "from": "g1",
          "to": "g2"
        },
        {
          "name": "fan_speed_down",
          "from": "g2",
          "to": "g1"
        }
      ],
      "baseline_seconds": 5,
      "state_timeout_seconds": 30,
      "poll_seconds": 3,
      "tail_seconds": 30,
      "fresh_precondition_state": true,
      "allow_precondition_normalization": false,
      "verify_state_after_reopen": true,
      "inter_action_cooldown_seconds": 0,
      "detail_page_timeout_seconds": 15,
      "state_view": "detail_slider",
      "tile_name": "LivingRoom-merossSmartWi-FiAirPurifier-TileCell",
      "detail_slider": {
        "label": "空气净化器",
        "state_value_ranges": {
          "off": [
            0,
            0
          ],
          "g1": [
            25,
            25
          ],
          "g2": [
            50,
            50
          ],
          "g3": [
            75,
            75
          ],
          "g4": [
            100,
            100
          ]
        },
        "state_fractions": {
          "g1": 0.695,
          "g2": 0.565,
          "g3": 0.435,
          "g4": 0.305
        },
        "duration_seconds": 0.4
      },
      "max_consecutive_failures": 1
    }
  ]
}
