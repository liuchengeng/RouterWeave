{
  "experiment": "german_smart_cordless_kettle_alexa_power",
  "control_platform": "alexa",
  "target_valid_per_action": 30,
  "router": {
    "host": "${ROUTERWEAVE_ROUTER_HOST}",
    "user": "root",
    "interface": "br-lan",
    "identity_file": "${ROUTERWEAVE_SSH_KEY}",
    "capture_filter": "ether host ${ROUTERWEAVE_WIFI_SMART_CORDLESS_KETTLE_01_MAC}"
  },
  "controller": {
    "identifier": "${IOS_UDID}",
    "application": "Amazon Alexa",
    "application_bundle_id": "com.amazon.echo",
    "wda_url": "http://127.0.0.1:8100",
    "snapshot_max_depth": 50
  },
  "detail_page_marker": "DCPV2::ControlPage",
  "navigation": {
    "device_list_marker": "DevicePageDeviceList",
    "back_wait_seconds": 1
  },
  "devices": [
    {
      "id": "wifi-smart-cordless-kettle-01",
      "name": "WiFi Smart Cordless Kettle",
      "model": "German Smart Cordless Kettle",
      "device_type": "electric_kettle",
      "ip": "${ROUTERWEAVE_WIFI_SMART_CORDLESS_KETTLE_01_IP}",
      "mac": "${ROUTERWEAVE_WIFI_SMART_CORDLESS_KETTLE_01_MAC}",
      "observed_via": "direct_device",
      "view": "detail",
      "navigation_mode": "semantic_detail",
      "control_element_name": "PowerControl::TouchArea",
      "state_element_name": "PowerControl::StateText",
      "states": {
        "on": [
          "On"
        ],
        "off": [
          "Off"
        ]
      },
      "actions": [
        {
          "name": "power_on",
          "from": "off",
          "to": "on"
        },
        {
          "name": "power_off",
          "from": "on",
          "to": "off"
        }
      ],
      "baseline_seconds": 5,
      "tail_seconds": 30,
      "poll_seconds": 3,
      "state_timeout_seconds": 30,
      "fresh_precondition_state": true,
      "reuse_current_detail": true,
      "allow_precondition_normalization": false,
      "verify_state_after_reopen": true,
      "detail_page_timeout_seconds": 15,
      "open_wait_seconds": 2,
      "launch_wait_seconds": 1,
      "inter_action_cooldown_seconds": 0
    }
  ],
  "operator_precondition": "Before running the plan, check the current water level and that heating is safe."
}
