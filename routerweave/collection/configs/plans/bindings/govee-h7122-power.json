{
  "experiment": "govee_h7122_alexa_power_formal_01",
  "control_platform": "alexa",
  "target_valid_per_action": 10,
  "router": {
    "host": "${ROUTERWEAVE_ROUTER_HOST}",
    "user": "root",
    "interface": "br-lan",
    "identity_file": "${ROUTERWEAVE_SSH_KEY}",
    "capture_filter": "ether host ${ROUTERWEAVE_GOVEE_H7122_MAC}"
  },
  "controller": {
    "identifier": "${IOS_UDID}",
    "application": "Amazon Alexa",
    "application_bundle_id": "com.amazon.echo",
    "wda_url": "http://127.0.0.1:8100",
    "snapshot_max_depth": 50
  },
  "detail_page_marker": "DCPV2::ControlPage",
  "navigation": {
    "device_list_marker": "DevicePageSearchButton",
    "back_wait_seconds": 2
  },
  "devices": [
    {
      "id": "govee-h7122",
      "name": "Smart Air Purifier",
      "brand": "Govee",
      "model": "H7122",
      "device_type": "air_purifier",
      "observed_via": "direct_device",
      "view": "detail",
      "navigation_mode": "semantic_detail",
      "control_element_name": "PowerControl::TouchArea",
      "state_element_name": "PowerControl::StateText",
      "states": {
        "on": [
          "On"
        ],
        "off": [
          "Off"
        ]
      },
      "actions": [
        {
          "name": "power_on",
          "from": "off",
          "to": "on"
        },
        {
          "name": "power_off",
          "from": "on",
          "to": "off"
        }
      ],
      "baseline_seconds": 5,
      "state_timeout_seconds": 30,
      "poll_seconds": 3,
      "tail_seconds": 30,
      "fresh_precondition_state": true,
      "allow_precondition_normalization": false,
      "verify_state_after_reopen": true,
      "inter_action_cooldown_seconds": 0,
      "detail_page_timeout_seconds": 15,
      "ip": "${ROUTERWEAVE_GOVEE_H7122_IP}",
      "mac": "${ROUTERWEAVE_GOVEE_H7122_MAC}"
    }
  ]
}
