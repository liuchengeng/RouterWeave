{
  "experiment": "xiaomi_desktop_fan_alexa_adjacent_speed",
  "control_platform": "alexa",
  "target_valid_per_action": 30,
  "router": {
    "host": "${ROUTERWEAVE_ROUTER_HOST}",
    "user": "root",
    "interface": "br-lan",
    "identity_file": "${ROUTERWEAVE_SSH_KEY}",
    "capture_filter": "ether host ${ROUTERWEAVE_XIAOMI_DESKTOP_CIRCULATION_FAN_01_MAC}"
  },
  "controller": {
    "identifier": "${IOS_UDID}",
    "application": "Amazon Alexa",
    "application_bundle_id": "com.amazon.echo",
    "wda_url": "http://127.0.0.1:8100",
    "snapshot_max_depth": 50
  },
  "detail_page_marker": "DCPV2::ControlPage",
  "navigation": {
    "device_list_marker": "DevicePageDeviceList",
    "back_wait_seconds": 1
  },
  "devices": [
    {
      "id": "xiaomi-desktop-circulation-fan-01",
      "name": "小米直流变频台式循环扇   ",
      "model": "DC Inverter Desktop Circulation Fan",
      "device_type": "electric_fan",
      "ip": "${ROUTERWEAVE_XIAOMI_DESKTOP_CIRCULATION_FAN_01_IP}",
      "mac": "${ROUTERWEAVE_XIAOMI_DESKTOP_CIRCULATION_FAN_01_MAC}",
      "observed_via": "direct_device",
      "view": "detail",
      "navigation_mode": "semantic_detail",
      "states": {
        "g1": [
          "Level 1"
        ],
        "g2": [
          "Level 2"
        ],
        "g3": [
          "Level 3"
        ],
        "g4": [
          "Level 4"
        ]
      },
      "actions": [
        {
          "name": "fan_speed_down",
          "from": "g2",
          "to": "g1"
        },
        {
          "name": "fan_speed_up",
          "from": "g1",
          "to": "g2"
        }
      ],
      "mode_menu": {
        "open_name": "ModeControl::PillButtonCenter",
        "dismiss_name": "ModeControl::ModeList_dismiss_overlay",
        "option_name": "Mosaic.checkmark_list_item",
        "checked_value": "radio button, checked",
        "state_labels": {
          "g1": "Level 1",
          "g2": "Level 2",
          "g3": "Level 3",
          "g4": "Level 4"
        }
      },
      "baseline_seconds": 5,
      "tail_seconds": 30,
      "poll_seconds": 3,
      "state_timeout_seconds": 30,
      "fresh_precondition_state": true,
      "reuse_current_detail": true,
      "allow_precondition_normalization": false,
      "verify_state_after_reopen": true,
      "detail_page_timeout_seconds": 15,
      "open_wait_seconds": 2,
      "launch_wait_seconds": 1,
      "inter_action_cooldown_seconds": 0
    }
  ]
}
