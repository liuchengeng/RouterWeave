{
  "experiment": "alexa_iot_continuous_30x",
  "control_platform": "alexa",
  "target_valid_per_action": 30,
  "router": {
    "host": "${ROUTERWEAVE_ROUTER_HOST}",
    "user": "root",
    "interface": "br-lan",
    "identity_file": "${ROUTERWEAVE_SSH_KEY}"
  },
  "controller": {
    "application": "Amazon Alexa",
    "application_bundle_id": "com.amazon.echo",
    "wda_url": "http://127.0.0.1:8100"
  },
  "detail_page_marker": "DCPV2::ControlPage",
  "navigation": {
    "device_list_marker": "Devices Search devices Device Type Sort By",
    "back_tap": {
      "x": 30,
      "y": 42
    },
    "back_wait_seconds": 3
  },
  "devices": [
    {
      "id": "meross-mss110",
      "name": "meross smart plug",
      "device_type": "smart_plug",
      "ip": "${ROUTERWEAVE_MEROSS_MSS110_IP}",
      "mac": "${ROUTERWEAVE_MEROSS_MSS110_MAC}",
      "view": "list",
      "control_tap": {
        "x": 317,
        "y": 461
      },
      "initial_state": "off",
      "state_match": "name_label",
      "states": {
        "off": "Off",
        "on": "On"
      },
      "actions": [
        {
          "name": "power_on",
          "from": "off",
          "to": "on"
        },
        {
          "name": "power_off",
          "from": "on",
          "to": "off"
        }
      ],
      "baseline_seconds": 5,
      "state_timeout_seconds": 30,
      "poll_seconds": 2,
      "tail_seconds": 30
    },
    {
      "id": "d1-lock",
      "name": "D1",
      "device_type": "smart_lock",
      "ip": "${ROUTERWEAVE_D1_LOCK_IP}",
      "mac": "${ROUTERWEAVE_D1_LOCK_MAC}",
      "observed_via": "alexa_integration",
      "view": "detail",
      "list_tap": {
        "x": 188,
        "y": 310
      },
      "control_tap": {
        "x": 188,
        "y": 264
      },
      "keep_awake_tap": {
        "x": 188,
        "y": 42
      },
      "initial_state": "locked",
      "state_match": "label",
      "states": {
        "locked": [
          "Locked",
          "已锁"
        ],
        "unlocked": [
          "Unlocked",
          "未锁"
        ]
      },
      "actions": [
        {
          "name": "unlock",
          "from": "locked",
          "to": "unlocked"
        },
        {
          "name": "lock",
          "from": "unlocked",
          "to": "locked"
        }
      ],
      "baseline_seconds": 5,
      "state_timeout_seconds": 120,
      "poll_seconds": 5,
      "tail_seconds": 30
    },
    {
      "id": "ultraloq-bolt",
      "name": "Bolt Fingerprint",
      "device_type": "smart_lock",
      "ip": "${ROUTERWEAVE_ULTRALOQ_BOLT_IP}",
      "mac": "${ROUTERWEAVE_ULTRALOQ_BOLT_MAC}",
      "observed_via": "alexa_integration",
      "view": "detail",
      "list_tap": {
        "x": 188,
        "y": 386
      },
      "control_tap": {
        "x": 188,
        "y": 264
      },
      "keep_awake_tap": {
        "x": 188,
        "y": 42
      },
      "initial_state": "locked",
      "state_match": "label",
      "states": {
        "locked": [
          "Locked",
          "已锁"
        ],
        "unlocked": [
          "Unlocked",
          "未锁"
        ]
      },
      "actions": [
        {
          "name": "unlock",
          "from": "locked",
          "to": "unlocked"
        },
        {
          "name": "lock",
          "from": "unlocked",
          "to": "locked"
        }
      ],
      "baseline_seconds": 5,
      "state_timeout_seconds": 120,
      "poll_seconds": 5,
      "tail_seconds": 30
    }
  ]
}
