{
  "experiment": "alexa_echo_dot_4th_gen_playback_30x",
  "control_platform": "alexa",
  "target_valid_per_action": 30,
  "launch_wait_seconds": 3,
  "max_consecutive_failures": 2,
  "dashboard_condition": {
    "selector": {
      "type": "XCUIElementTypeButton",
      "name": "DevicePageSearchButton",
      "label": "Search devices"
    }
  },
  "router": {
    "host": "${ROUTERWEAVE_ROUTER_HOST}",
    "user": "root",
    "interface": "br-lan",
    "identity_file": "${ROUTERWEAVE_SSH_KEY}",
    "capture_filter": "host ${ROUTERWEAVE_AMAZON_ECHO_DOT_4TH_GEN_IP}"
  },
  "controller": {
    "identifier": "${IOS_UDID}",
    "application": "Amazon Alexa",
    "application_bundle_id": "com.amazon.echo",
    "wda_url": "http://127.0.0.1:8100"
  },
  "devices": [
    {
      "id": "amazon-echo-dot-4th-gen",
      "name": "Living Room Echo Dot",
      "brand": "Amazon",
      "model": "Echo Dot (4th generation)",
      "device_type": "smart_speaker",
      "manage_playback_volume": false,
      "ip": "${ROUTERWEAVE_AMAZON_ECHO_DOT_4TH_GEN_IP}",
      "mac": "${ROUTERWEAVE_AMAZON_ECHO_DOT_4TH_GEN_MAC}",
      "actions": [
        "play",
        "pause"
      ],
      "open_method": "platform_selector",
      "open_wait_seconds": 5,
      "baseline_seconds": 5,
      "tail_seconds": 30,
      "poll_seconds": 10,
      "state_timeout_seconds": 30,
      "inter_action_cooldown_seconds": 0,
      "ui": {
        "entry_selector": {
          "type": "XCUIElementTypeButton",
          "name": "TestID-Now Playing-Button",
          "label": "Now Playing"
        },
        "page_condition": {
          "all": [
            {
              "selector": {
                "type": "XCUIElementTypeOther",
                "name": "now_playing_screen_header_Bar"
              }
            },
            {
              "selector": {
                "type": "XCUIElementTypeOther",
                "name": "now-playing-screen-device-picker",
                "label": "now-playing-screen-device-picker_button"
              }
            },
            {
              "selector": {
                "type": "XCUIElementTypeStaticText",
                "name": "Living Room Echo Dot",
                "label": "Living Room Echo Dot"
              }
            }
          ]
        },
        "playing_condition": {
          "selector": {
            "type": "XCUIElementTypeOther",
            "name": "now_playing_control_pause",
            "label": "now_playing_control-pause"
          }
        },
        "paused_condition": {
          "selector": {
            "type": "XCUIElementTypeOther",
            "name": "now_playing_control_play",
            "label": "now_playing_control-play"
          }
        },
        "play_selector": {
          "type": "XCUIElementTypeOther",
          "name": "now_playing_control_play",
          "label": "now_playing_control-play"
        },
        "pause_selector": {
          "type": "XCUIElementTypeOther",
          "name": "now_playing_control_pause",
          "label": "now_playing_control-pause"
        }
      }
    }
  ]
}
