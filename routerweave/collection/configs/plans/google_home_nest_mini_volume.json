{
  "experiment": "google_home_nest_mini_idle_volume_30x",
  "control_platform": "google_home",
  "target_valid_per_action": 30,
  "max_consecutive_failures": 2,
  "router": {
    "host": "${ROUTERWEAVE_ROUTER_HOST}",
    "user": "root",
    "interface": "br-lan",
    "identity_file": "${ROUTERWEAVE_SSH_KEY}",
    "capture_filter": "ether host ${ROUTERWEAVE_GOOGLE_NEST_MINI_MAC}"
  },
  "controller": {
    "identifier": "${IOS_UDID}",
    "application": "Google Home",
    "application_bundle_id": "com.google.Chromecast",
    "wda_url": "http://127.0.0.1:8100"
  },
  "parameter_policy": {
    "smart_speaker_volume": {
      "random_seed": 2026101101,
      "low_range_percent": [
        10,
        40
      ],
      "high_range_percent": [
        60,
        90
      ],
      "minimum_change_percent": 20,
      "step_percent": 5
    }
  },
  "devices": [
    {
      "id": "google-nest-mini",
      "name": "Living Room speaker",
      "brand": "Google",
      "model": "Nest Mini",
      "device_type": "smart_speaker",
      "ip": "${ROUTERWEAVE_GOOGLE_NEST_MINI_IP}",
      "mac": "${ROUTERWEAVE_GOOGLE_NEST_MINI_MAC}",
      "actions": [
        "volume_up",
        "volume_down"
      ],
      "open_gesture": "long_press",
      "open_wait_seconds": 3,
      "baseline_seconds": 5,
      "tail_seconds": 30,
      "poll_seconds": 5,
      "state_timeout_seconds": 30,
      "volume_tolerance": 5,
      "volume_command_attempts": 2,
      "volume_attempt_timeout_seconds": 12,
      "max_consecutive_failures": 2,
      "ui": {
        "page_condition": {
          "all": [
            {
              "selector": {
                "type": "XCUIElementTypeStaticText",
                "name": "Living Room speaker"
              }
            },
            {
              "selector": {
                "type": "XCUIElementTypeButton",
                "name": "closeButton"
              }
            },
            {
              "selector": {
                "type": "XCUIElementTypeOther",
                "name": "continuousSlider"
              }
            }
          ]
        },
        "idle_condition": {
          "any": [
            {
              "selector": {
                "type": "XCUIElementTypeStaticText",
                "name": "mediaTileTitleLabel",
                "label": "当前未播放任何内容"
              }
            },
            {
              "selector": {
                "type": "XCUIElementTypeButton",
                "name": "mediaTilePlayPauseButton",
                "label": "play arrow symbol",
                "enabled": true
              }
            }
          ]
        },
        "close_selector": {
          "type": "XCUIElementTypeButton",
          "name": "closeButton"
        },
        "volume": {
          "selector": {
            "type": "XCUIElementTypeOther",
            "name": "continuousSlider"
          },
          "mode": "linear",
          "gesture": "tap",
          "orientation": "horizontal",
          "high_at_start": false,
          "edge_margin_fraction": 0.0,
          "duration_seconds": 0.8
        }
      }
    }
  ]
}
